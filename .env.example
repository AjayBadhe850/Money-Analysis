# ==============================================================================
# Money Analysis – Production Environment Variables Configuration Template
# ==============================================================================

# Application & Environment Settings
PROJECT_NAME="Money Analysis – Multi-Agent Finance Controller"
STAGE=3
ENABLE_AI_AGENTS=true

# Security & JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL with pgvector)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/money_analysis_db"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# Redis Cloud & Celery Task Queue
REDIS_URL="redis://localhost:6379/0"

# AI & LLM Provider Configuration
# Options: "gemini", "openai", "mock" (default offline fallback)
LLM_PROVIDER="mock"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
OPENAI_API_KEY="sk-proj-YourOpenAIApiKeyHere"
LLM_MODEL="gemini-1.5-flash"

# Document Storage (Cloudinary or AWS S3 for invoices/contracts/receipts)
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# AWS S3 (Alternative to Cloudinary)
AWS_S3_BUCKET="money-analysis-enterprise-documents"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"

# Sentry Application Performance & Error Observability
SENTRY_DSN=""

# Rate Limiting Guardrails
RATE_LIMIT_PER_MINUTE=120

# Service URLs & CORS Whitelist
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"
